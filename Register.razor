@page "/register"

@using EventManagementApp.Services

@inject EventService EventService
@using Microsoft.AspNetCore.Components.Web
<PageTitle>Registration | EventPro</PageTitle>

<div class="page-container narrow-container">

    <div class="page-heading">

        <div>

            <span class="section-label">
                PARTICIPANT MANAGEMENT
            </span>

            <h1>
                Event Registration
            </h1>

            <p>
                Register a participant for an upcoming event.
            </p>

        </div>

    </div>

    <div class="registration-layout">

        <div class="form-card">

            <div class="card-header">

                <div class="card-header-icon">
                    +
                </div>

                <div>
                    <h3>
                        Participant Information
                    </h3>

                    <p>
                        Enter the participant's details below.
                    </p>
                </div>

            </div>

            <RegistrationForm EventId="@SelectedEventId"
                              OnRegistered="HandleRegistered" />

        </div>

        <div class="info-card">

            <div class="info-icon">
                ✓
            </div>

            <h3>
                Registration Process
            </h3>

            <ul>

                <li>
                    Select an available event
                </li>

                <li>
                    Enter participant details
                </li>

                <li>
                    Submit the registration
                </li>

                <li>
                    Participant can be checked in on event day
                </li>

            </ul>

        </div>

    </div>

</div>

@code {

    private int SelectedEventId;

    protected override void OnInitialized()
    {
        SelectedEventId =
            EventService.GetEvents()
                .FirstOrDefault()?.Id ?? 0;
    }

    private void HandleRegistered()
    {
        StateHasChanged();
    }
}